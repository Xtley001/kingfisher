# ── NETWORK ────────────────────────────────────────────────────────────────────
NETWORK=testnet                     # "testnet" | "mainnet"

# ── RPC / SUBMISSION ─────────────────────────────────────────────────────────
# IPC path for co-located Arbitrum Nitro node (~0.1ms latency). Leave blank for cloud.
RPC_IPC_PATH=                       # /run/nitro/arb.ipc  (build with --features ipc)

# WebSocket — primary external RPC (used only if IPC is not set)
RPC_WS_URL=                         # Arbitrum WebSocket (local Nitro / Alchemy / QuickNode)
RPC_HTTP_URL=                       # Arbitrum HTTP — should be your lowest-latency sequencer endpoint
RPC_FALLBACK_URL=                   # Backup WebSocket — different provider

# Optional: Arbitrum Timeboost express-lane endpoint for priority sequencing.
# If set, arb transactions are broadcast here instead of the plain sequencer RPC.
TIMEBOOST_EXPRESS_LANE_URL=
# Optional: secondary endpoint for a best-effort mirror broadcast (redundancy).
SEQUENCER_BACKUP_URL=               # e.g. https://arb.tx.blxrbdn.com

# ── KEYS ───────────────────────────────────────────────────────────────────────
# BOT_PRIVATE_KEY  = hot wallet — signs executeArb(), holds gas ETH only (0.3–1.0 ETH)
# COLD_WALLET_ADDR = cold wallet — owns contract, receives profit withdrawals
BOT_PRIVATE_KEY=                    # Hot wallet private key (NEVER your cold wallet)
COLD_WALLET_ADDR=                   # Cold wallet address (Ledger / Gnosis Safe)
# Deploy only — used once by forge script/Deploy.s.sol, then remove from server.
# After deploy call setOperator(HOT_WALLET) immediately from the cold wallet.
COLD_WALLET_PRIVATE_KEY=            # Cold wallet key — deploy script ONLY
ARBISCAN_KEY=                       # For contract verification

# ── CONTRACT ADDRESSES ─────────────────────────────────────────────────────────
CONTRACT_ADDRESS_TESTNET=           # Filled after testnet deploy
CONTRACT_ADDRESS_MAINNET=           # Filled after mainnet deploy

# ── BOT PARAMETERS ─────────────────────────────────────────────────────────────
MIN_PROFIT_USD=10                   # Absolute floor. Effective floor = max(MIN_PROFIT_USD, gas×MIN_GAS_ROI)
MIN_GAS_ROI=3.0                     # Min ROI multiple on gas. 3.0 = 300%. Filters bad risk/reward trades.
MIN_IMBALANCE_PCT=5                 # Pool imbalance threshold %
MIN_VELOCITY=0.015                  # Freshness filter (imbalance change per block)
GAS_RESERVE_ETH=0.10                # Hard halt — bot stops trading below this
ALERT_GAS_ETH=0.30                  # Telegram refill reminder threshold
GAS_LIMIT_OVERRIDE=750000           # Gas limit for arb transactions

# ── SIZING ─────────────────────────────────────────────────────────────────────
# Start at $5M. Raise to 25000000 via dashboard after first clean profitable day.
# Hard ceiling in sizing.rs (HARD_CAP_USD) is $25M — never set ABS_CAP_USD above that.
ABS_CAP_USD=5000000

# ── GAS MODEL ──────────────────────────────────────────────────────────────────
# Ethereum L1 base fee (gwei) used to estimate Arbitrum's L1 calldata-posting cost —
# the dominant per-tx cost on Arbitrum. Tune to track current Ethereum gas.
L1_BASE_FEE_GWEI=10

# ── PERSISTENCE ────────────────────────────────────────────────────────────────
# Directory for params.json + trades.jsonl. Defaults to /var/lib/kingfisher on bare metal.
KINGFISHER_DATA_DIR=

# ── API ─────────────────────────────────────────────────────────────────────────
API_PORT=3001
API_KEY=                            # Generate: openssl rand -hex 32
DASHBOARD_ORIGIN=http://localhost:5173

# ── ALERTS ──────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                 # Highly recommended for mainnet
TELEGRAM_CHAT_ID=

# ── OBSERVABILITY ─────────────────────────────────────────────────────────────
# Prometheus scrapes GET /metrics — restrict at network layer, no auth header
